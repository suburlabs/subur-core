strict-peer-dependencies=false
enable-pre-post-scripts=true
# Opció (b) de l'spec §3.1 (pla E2, R3): el motor, Next, React, Tailwind, eslint-config-next i graphql són dependències
# exactes del nucli i es resolen des de l'arrel del workspace (bins inclosos). Mateixa llista que el .npmrc del client.
public-hoist-pattern[]=next
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=payload
public-hoist-pattern[]=@payloadcms/*
public-hoist-pattern[]=tailwindcss
public-hoist-pattern[]=@tailwindcss/*
public-hoist-pattern[]=eslint-config-next
public-hoist-pattern[]=graphql
