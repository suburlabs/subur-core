{
  "name": "subur-{{slug}}",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "subur sync",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "prebuild": "subur sync",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "preseed": "subur sync",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/site/seed/run.ts",
    "migrate": "subur migrate",
    "check": "subur check",
    "gate": "subur gate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@suburlabs/core": "{{coreVersion}}",
    "cross-env": "7.0.3",
    "next-sitemap": "4.2.3",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "typescript": "5.7.3"
  }
}
